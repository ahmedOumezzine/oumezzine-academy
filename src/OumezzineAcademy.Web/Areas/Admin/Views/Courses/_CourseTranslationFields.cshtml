@model (CourseTranslationInput Input, string Prefix, string Language)
<div class="course-translation-fields">
    <div class="course-fields-grid">
        <div><label for="@Model.Prefix-Title">@(Model.Language == "Français" ? "Titre" : "Title")</label><input id="@Model.Prefix-Title" name="@(Model.Prefix).Title" value="@Model.Input.Title" data-slug-title="@Model.Prefix" /><span class="field-error" asp-validation-for="Input.Title"></span></div>
        <div><label for="@Model.Prefix-Slug">Slug <button type="button" class="slug-generate" data-slug-from="@(Model.Prefix).Title" data-slug-target="@(Model.Prefix).Slug">Générer</button></label><input id="@Model.Prefix-Slug" name="@(Model.Prefix).Slug" value="@Model.Input.Slug" /><span class="field-error" asp-validation-for="Input.Slug"></span></div>
    </div>
    <label for="@Model.Prefix-Summary">@(Model.Language == "Français" ? "Résumé" : "Summary")</label><textarea id="@Model.Prefix-Summary" name="@(Model.Prefix).Summary" rows="3" maxlength="500">@Model.Input.Summary</textarea>
    <label for="@Model.Prefix-Overview">@(Model.Language == "Français" ? "Présentation" : "Overview")</label><textarea id="@Model.Prefix-Overview" name="@(Model.Prefix).Overview" rows="5">@Model.Input.Overview</textarea>
    <details class="course-advanced-fields"><summary>Informations complémentaires et SEO</summary><label for="@Model.Prefix-WhatYouLearn">Ce que vous apprendrez</label><textarea id="@Model.Prefix-WhatYouLearn" name="@(Model.Prefix).WhatYouLearn" rows="3">@Model.Input.WhatYouLearn</textarea><label for="@Model.Prefix-Requirements">Prérequis détaillés</label><textarea id="@Model.Prefix-Requirements" name="@(Model.Prefix).Requirements" rows="3">@Model.Input.Requirements</textarea><label for="@Model.Prefix-Audience">Public visé</label><textarea id="@Model.Prefix-Audience" name="@(Model.Prefix).Audience" rows="3">@Model.Input.Audience</textarea><div class="course-fields-grid"><div><label for="@Model.Prefix-MetaTitle">Meta title</label><input id="@Model.Prefix-MetaTitle" name="@(Model.Prefix).MetaTitle" value="@Model.Input.MetaTitle" maxlength="70" /></div><div><label for="@Model.Prefix-MetaDescription">Meta description</label><textarea id="@Model.Prefix-MetaDescription" name="@(Model.Prefix).MetaDescription" rows="2" maxlength="160">@Model.Input.MetaDescription</textarea></div></div></details>
    <div class="course-publication-row"><div><label for="@Model.Prefix-PublicationStatus">Statut @Model.Language</label><select id="@Model.Prefix-PublicationStatus" name="@(Model.Prefix).PublicationStatus">@foreach (var status in Enum.GetValues<StudyStatus>()) { <option value="@status" selected="@(status == Model.Input.PublicationStatus ? "selected" : null)">@status</option> }</select></div><p>Publiez uniquement lorsque le titre, le slug et le résumé sont prêts.</p></div>
</div>
