@model (LessonTranslationInput Input, string Prefix, string Language)
<div class="lesson-seo-fields"><div><label for="@Model.Prefix-MetaTitle">Titre SEO <span class="field-optional">(optionnel)</span> <span class="char-count" data-count-for="@(Model.Prefix).MetaTitle">0 / 60</span></label><input id="@Model.Prefix-MetaTitle" name="@(Model.Prefix).MetaTitle" value="@Model.Input.MetaTitle" maxlength="60" /></div><div><label for="@Model.Prefix-MetaDescription">Description SEO <span class="field-optional">(optionnel)</span> <span class="char-count" data-count-for="@(Model.Prefix).MetaDescription">0 / 160</span></label><textarea id="@Model.Prefix-MetaDescription" name="@(Model.Prefix).MetaDescription" rows="3" maxlength="160">@Model.Input.MetaDescription</textarea></div></div>
