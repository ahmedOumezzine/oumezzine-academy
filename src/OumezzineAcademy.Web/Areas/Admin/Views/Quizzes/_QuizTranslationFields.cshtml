@model (QuizTranslationInput Input, string Prefix, string Language)
<div class="course-translation-fields"><label for="@Model.Prefix-Title">@(Model.Language == "Français" ? "Titre" : "Title")</label><input id="@Model.Prefix-Title" name="@(Model.Prefix).Title" value="@Model.Input.Title" /><label for="@Model.Prefix-Slug">Slug <button type="button" class="slug-generate" data-slug-from="@(Model.Prefix).Title" data-slug-target="@(Model.Prefix).Slug">Générer</button></label><input id="@Model.Prefix-Slug" name="@(Model.Prefix).Slug" value="@Model.Input.Slug" /><label for="@Model.Prefix-Summary">Résumé</label><textarea id="@Model.Prefix-Summary" name="@(Model.Prefix).Summary" rows="4">@Model.Input.Summary</textarea><label for="@Model.Prefix-Status">Statut de publication</label><select id="@Model.Prefix-Status" name="@(Model.Prefix).PublicationStatus">@foreach (var status in Enum.GetValues<StudyStatus>()) { <option value="@status" selected="@(status == Model.Input.PublicationStatus ? "selected" : null)">@status</option> }</select></div>
