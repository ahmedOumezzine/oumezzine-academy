@model AdminQuizListViewModel
@{ ViewData["Title"] = "Quiz"; }
<div class="admin-page content-admin-page">
<nav class="admin-breadcrumb" aria-label="Fil d’Ariane">
<a asp-controller="Courses" asp-action="Index">Cours</a>
<span>›</span>
<a asp-controller="Chapters" asp-action="Index" asp-route-courseId="@Model.CourseId">@Model.CourseTitle</a>
<span>›</span>
<strong>@Model.ChapterTitle</strong>
<span>›</span>
<strong>Quiz</strong>
</nav>
<div class="admin-heading content-heading">
<div>
<p class="eyebrow">QUIZ DU CHAPITRE</p>
<h1>Quiz</h1>
<p>Gérez les quiz de ce chapitre.</p>
</div>
<div class="content-heading-actions">
<a class="btn-ghost" asp-controller="Chapters" asp-action="Index" asp-route-courseId="@Model.CourseId">Retour au chapitre</a>
<a class="btn-main" asp-action="Create" asp-route-courseId="@Model.CourseId" asp-route-chapterId="@Model.ChapterId">+ Créer un quiz</a>
</div>
</div>
<section class="content-course-summary">
<div class="content-course-info">
<h2>@Model.ChapterTitle</h2>
<p>Chapitre @Model.ChapterOrder <span aria-hidden="true">•</span> @Model.CourseTitle</p>
<div class="content-statuses">
<span>FR : @await Html.PartialAsync("_AdminStatusBadge", Model.FrenchStatus)</span>
<span>EN : @await Html.PartialAsync("_AdminStatusBadge", Model.EnglishStatus)</span>
</div>
</div>
<div class="content-stats">
<div>
<strong>@Model.LessonsCount</strong>
<span>Leçons</span>
</div>
<div>
<strong>@Model.Quizzes.Count</strong>
<span>Quiz</span>
</div>
</div>
</section>@if (TempData["Success"] is not null) { <div class="admin-alert success">@TempData["Success"]</div> } @if (TempData["Error"] is not null) { <div class="admin-alert error">@TempData["Error"]</div> }<div class="content-table-wrap">
<table class="admin-table content-table">
<thead>
<tr>
<th>Ordre</th>
<th>Titre du quiz</th>
<th>FR</th>
<th>EN</th>
<th>Questions</th>
<th>Actions</th>
</tr>
</thead>
<tbody>@foreach (var item in Model.Quizzes) { <tr>
<td>
<span class="order-badge">@item.Order.ToString("00")</span>
</td>
<td>
<strong class="content-title">@item.Title</strong>
</td>
<td>@await Html.PartialAsync("_AdminStatusBadge", item.FrenchStatus)</td>
<td>@await Html.PartialAsync("_AdminStatusBadge", item.EnglishStatus)</td>
<td>@item.QuestionsCount question(s)</td>
<td>
<div class="content-actions">
<a class="content-action-primary" asp-controller="Questions" asp-action="Index" asp-route-courseId="@Model.CourseId" asp-route-chapterId="@Model.ChapterId" asp-route-quizId="@item.Id">Questions</a>
<a class="edit-action" asp-action="Edit" asp-route-courseId="@Model.CourseId" asp-route-chapterId="@Model.ChapterId" asp-route-id="@item.Id">Modifier</a>
<form asp-action="Move" asp-route-courseId="@Model.CourseId" asp-route-chapterId="@Model.ChapterId" asp-route-id="@item.Id" asp-route-direction="-1" method="post">
<button class="icon-action" type="submit" disabled="@item.IsFirst" aria-label="Monter">↑</button>
</form>
<form asp-action="Move" asp-route-courseId="@Model.CourseId" asp-route-chapterId="@Model.ChapterId" asp-route-id="@item.Id" asp-route-direction="1" method="post">
<button class="icon-action" type="submit" disabled="@item.IsLast" aria-label="Descendre">↓</button>
</form>
<form asp-action="Delete" asp-route-courseId="@Model.CourseId" asp-route-chapterId="@Model.ChapterId" asp-route-id="@item.Id" method="post">
<button class="icon-action danger" type="submit" aria-label="Supprimer @item.Title" data-confirm-delete data-confirm-item="@item.Title" data-confirm-message="supprimer ce quiz">×</button>
</form>
</div>
</td>
</tr> }</tbody>
</table>
</div>@if (Model.Quizzes.Count == 0) { <div class="content-empty">
<h2>Aucun quiz dans ce chapitre.</h2>
<p>Ajoutez une première évaluation.</p>
<a class="btn-main" asp-action="Create" asp-route-courseId="@Model.CourseId" asp-route-chapterId="@Model.ChapterId">+ Créer un quiz</a>
</div> }</div>
