@model AdminQuizFormViewModel
@{ var isEdit = Model.Id != Guid.Empty; ViewData["Title"] = isEdit ? "Modifier le quiz" : "Créer un quiz"; var action = isEdit ? "Edit" : "Create"; }
<div class="admin-page content-admin-page"><nav class="admin-breadcrumb" aria-label="Fil d’Ariane"><a asp-controller="Courses" asp-action="Index">Cours</a><span>›</span><a asp-controller="Chapters" asp-action="Index" asp-route-courseId="@Model.CourseId">@Model.CourseTitle</a><span>›</span><a asp-controller="Quizzes" asp-action="Index" asp-route-courseId="@Model.CourseId" asp-route-chapterId="@Model.ChapterId">@Model.ChapterTitle</a><span>›</span><strong>@ViewData["Title"]</strong></nav><div class="admin-heading content-heading"><div><p class="eyebrow">QUIZ DU CHAPITRE</p><h1>@ViewData["Title"]</h1><p>Ajoutez ou modifiez une évaluation pour ce chapitre.</p></div><a class="btn-ghost" asp-action="Index" asp-route-courseId="@Model.CourseId" asp-route-chapterId="@Model.ChapterId">Retour aux quiz</a></div><form class="admin-form course-form" asp-action="@action" asp-route-courseId="@Model.CourseId" asp-route-chapterId="@Model.ChapterId" asp-route-id="@Model.Id" method="post">@await Html.PartialAsync("_AdminValidationSummary")<section class="course-form-card"><div class="course-section-title"><span class="section-icon">@await Html.PartialAsync("_AdminIcon", "quiz")</span><div><h2>Informations générales</h2><p>Définissez le chapitre et l’ordre de ce quiz.</p></div></div><div class="course-fields-grid"><div><label>Chapitre actuel</label><div class="readonly-field">@Model.ChapterTitle</div></div><div><label asp-for="Order">Ordre</label><input asp-for="Order" type="number" min="1" /></div></div><div class="course-tabs" role="tablist" aria-label="Traductions du quiz"><button type="button" class="course-tab is-active" role="tab" aria-selected="true" data-quiz-tab="quiz-fr">Français</button><button type="button" class="course-tab" role="tab" aria-selected="false" data-quiz-tab="quiz-en">English</button></div><div id="quiz-fr" class="course-tab-panel" role="tabpanel">@await Html.PartialAsync("_QuizTranslationFields", (Model.French, "French", "Français"))</div><div id="quiz-en" class="course-tab-panel" role="tabpanel" hidden>@await Html.PartialAsync("_QuizTranslationFields", (Model.English, "English", "English"))</div></section><div class="course-action-bar"><a class="btn-ghost" asp-action="Index" asp-route-courseId="@Model.CourseId" asp-route-chapterId="@Model.ChapterId">Annuler</a><button class="btn-main" type="submit">+ @(isEdit ? "Enregistrer les modifications" : "Enregistrer le quiz")</button></div></form></div>
@section Scripts { <script src="~/js/admin-quiz-form.js" asp-append-version="true"></script> }
