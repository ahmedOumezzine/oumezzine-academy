@model LearningPathCategoryEditViewModel
@{ var action = Model.Id == Guid.Empty ? "Create" : "Edit"; }
<form id="learning-path-category-form" class="admin-form path-category-form" asp-action="@action" method="post"><input asp-for="Id" type="hidden" />@await Html.PartialAsync("_AdminValidationSummary")<div class="path-category-form-grid"><section class="path-category-form-card"><div class="path-category-section-title"><span class="section-icon">@await Html.PartialAsync("_AdminIcon", "language")</span><div><h2>Traductions</h2><p>Renseignez les informations dans chaque langue.</p></div></div><div class="path-category-tabs" role="tablist"><button type="button" class="is-active" data-pc-tab="pc-fr" aria-selected="true">Français <span class="status-badge status-@Model.French.PublicationStatus.ToString().ToLowerInvariant()">@Model.French.PublicationStatus</span></button><button type="button" data-pc-tab="pc-en" aria-selected="false">English <span class="status-badge status-@Model.English.PublicationStatus.ToString().ToLowerInvariant()">@Model.English.PublicationStatus</span></button></div><div id="pc-fr" class="path-category-tab-panel">@await Html.PartialAsync("_LearningPathCategoryTranslationFields", (Model.French,"French","Français"))</div><div id="pc-en" class="path-category-tab-panel" hidden>@await Html.PartialAsync("_LearningPathCategoryTranslationFields", (Model.English,"English","English"))</div></section><aside class="path-category-form-aside"><section class="path-category-preview"><div class="path-category-section-title"><span class="section-icon">@await Html.PartialAsync("_AdminIcon", "preview")</span><div><h2>Aperçu</h2><p>Affichage de la langue sélectionnée.</p></div></div><h3 data-pc-preview-title>@(Model.French.Title ?? "Titre de la catégorie")</h3><p data-pc-preview-summary>@(Model.French.Summary ?? "Aucun résumé pour cette langue.")</p><div class="path-category-preview-meta"><span data-pc-preview-status>FR : @Model.French.PublicationStatus</span><span>0 parcours</span><span data-pc-preview-slug>/@(Model.French.Slug ?? "slug")</span></div></section><section class="path-category-advice"><h2>Conseils</h2><p>Utilisez un titre court et ajoutez une traduction anglaise si elle est disponible.</p></section></aside></div><div class="path-category-action-bar"><a class="btn-ghost" asp-action="Index">Annuler</a><button class="btn-main" type="submit">@(Model.Id == Guid.Empty ? "Créer la catégorie" : "Enregistrer les modifications")</button></div></form>
