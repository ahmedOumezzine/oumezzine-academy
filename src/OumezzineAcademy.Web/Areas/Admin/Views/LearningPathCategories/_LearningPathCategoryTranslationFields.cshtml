@model (LearningPathCategoryTranslationInput Input,string Prefix,string Language)
<div class="path-category-translation-fields"><div><label>Titre</label><input name="@(Model.Prefix).Title" value="@Model.Input.Title" /></div><div><label>Slug <button class="slug-generate" type="button" data-pc-from="@(Model.Prefix).Title" data-pc-target="@(Model.Prefix).Slug">Générer</button></label><input name="@(Model.Prefix).Slug" value="@Model.Input.Slug" /></div><div class="path-category-field-wide"><label>Résumé</label><textarea name="@(Model.Prefix).Summary" rows="3">@Model.Input.Summary</textarea></div><div class="path-category-field-wide"><h3>SEO</h3></div><div><label>Titre SEO</label><input name="@(Model.Prefix).MetaTitle" value="@Model.Input.MetaTitle" maxlength="60" /></div><div><label>Description SEO</label><textarea name="@(Model.Prefix).MetaDescription" rows="3" maxlength="160">@Model.Input.MetaDescription</textarea></div><div class="path-category-field-wide"><label>Statut</label><select name="@(Model.Prefix).PublicationStatus">@foreach(var status in Enum.GetValues<StudyStatus>()){<option value="@status" selected="@(status==Model.Input.PublicationStatus?"selected":null)">@status</option>}</select><small>Brouillon : non visible publiquement. Publié : visible dans cette langue.</small></div></div>
