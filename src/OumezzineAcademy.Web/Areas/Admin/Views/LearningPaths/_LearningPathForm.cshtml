@model LearningPathEditViewModel
@{ var isEdit = Model.Id != Guid.Empty; var action = isEdit ? "Edit" : "Create"; var image = Model.ThumbnailUrl; }
<form id="learning-path-form" class="admin-form learning-path-form" asp-action="@action" method="post" enctype="multipart/form-data">
<input asp-for="Id" type="hidden" />@await Html.PartialAsync("_AdminValidationSummary")
<div class="learning-path-form-grid"><div class="learning-path-form-main">
<section class="learning-path-card"><div class="learning-path-section-title"><span class="section-icon">@await Html.PartialAsync("_AdminIcon", "settings")</span><div><h2>Informations générales</h2><p>Définissez la catégorie et le niveau de ce parcours.</p></div></div><div class="learning-path-fields-grid"><div><label asp-for="CategoryId">Catégorie</label><select asp-for="CategoryId"><option value="">Sélectionner une catégorie</option>@foreach(var category in Model.Categories){<option value="@category.Id">@category.Title</option>}</select><span asp-validation-for="CategoryId" class="field-error"></span></div><div><label asp-for="Level">Niveau</label><select asp-for="Level" asp-items="Html.GetEnumSelectList<StudyLevel>()"></select></div></div></section>
<section class="learning-path-card"><div class="learning-path-section-title"><span class="section-icon">@await Html.PartialAsync("_AdminIcon", "image")</span><div><h2>Image du parcours</h2><p>Ajoutez une image représentative pour ce parcours.</p></div></div><div class="learning-path-upload-grid"><div class="learning-path-current-image"><img data-path-image-preview src="@image" alt="Aperçu de l’image du parcours" data-path-existing-image hidden="@(string.IsNullOrWhiteSpace(image))" /><span data-path-image-placeholder hidden="@(!string.IsNullOrWhiteSpace(image))">@await Html.PartialAsync("_AdminIcon", "image")<small>Aucune image</small></span></div><div><label class="learning-path-dropzone" for="LearningPathImage" data-path-dropzone><span>@await Html.PartialAsync("_AdminIcon", "image")</span><strong>Glissez-déposez une image ici</strong><small>ou cliquez pour parcourir vos fichiers<br />JPG, PNG ou WEBP • 5 Mo maximum</small></label><input id="LearningPathImage" asp-for="Thumbnail" class="learning-path-file-input" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" data-path-image-input /><p data-path-file-name>Aucune nouvelle image sélectionnée.</p></div></div></section>
<section class="learning-path-card"><div class="learning-path-section-title"><span class="section-icon">@await Html.PartialAsync("_AdminIcon", "language")</span><div><h2>Contenu localisé</h2><p>Renseignez les informations du parcours dans chaque langue.</p></div></div><div class="learning-path-tabs" role="tablist"><button type="button" class="is-active" data-path-tab="path-fr" aria-selected="true">Français <span class="status-badge status-@Model.French.PublicationStatus.ToString().ToLowerInvariant()">@Model.French.PublicationStatus</span></button><button type="button" data-path-tab="path-en" aria-selected="false">English <span class="status-badge status-@Model.English.PublicationStatus.ToString().ToLowerInvariant()">@Model.English.PublicationStatus</span></button></div><div id="path-fr" class="learning-path-tab-panel" role="tabpanel">@await Html.PartialAsync("_LearningPathTranslationFields", (Model.French,"French","Français"))</div><div id="path-en" class="learning-path-tab-panel" role="tabpanel" hidden>@await Html.PartialAsync("_LearningPathTranslationFields", (Model.English,"English","English"))</div></section>
</div><aside class="learning-path-form-aside"><section class="learning-path-preview-card"><div class="learning-path-section-title"><span class="section-icon">@await Html.PartialAsync("_AdminIcon", "preview")</span><div><h2>Aperçu du parcours</h2><p>Voici un aperçu de l’affichage public.</p></div></div><div class="learning-path-preview-image"><img data-path-preview-image src="@image" alt="Aperçu du parcours" hidden="@(string.IsNullOrWhiteSpace(image))" /><span data-path-preview-placeholder>@await Html.PartialAsync("_AdminIcon", "image")</span></div><span class="badge-soft" data-path-preview-category>@Model.SelectedCategoryTitle</span><h3 data-path-preview-title>@(Model.French.Title ?? "Titre du parcours")</h3><p data-path-preview-summary>@(Model.French.Summary ?? "Le résumé apparaîtra ici.")</p><div class="learning-path-preview-meta"><span data-path-preview-level>@Model.Level</span><span data-path-preview-fr-status>FR : @Model.French.PublicationStatus</span><span data-path-preview-en-status>EN : @Model.English.PublicationStatus</span></div></section><section class="learning-path-advice-card"><h2>Conseil</h2><p>Renseignez un titre accrocheur et une description claire pour améliorer la visibilité de votre parcours.</p></section></aside></div><div class="learning-path-action-bar"><a class="btn-ghost" asp-action="Index">Annuler</a><button class="btn-main" type="submit">@(isEdit ? "Enregistrer les modifications" : "Créer le parcours")</button></div>
</form>
