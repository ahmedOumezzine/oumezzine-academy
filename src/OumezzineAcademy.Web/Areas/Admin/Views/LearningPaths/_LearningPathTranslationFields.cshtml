@model (LearningPathTranslationInput Input,string Prefix,string Language)
<div class="learning-path-translation-fields"><div><label>@(Model.Language=="Français"?"Titre":"Title")</label><input name="@(Model.Prefix).Title" value="@Model.Input.Title" /></div><div><label>Slug <button type="button" class="slug-generate" data-path-slug-from="@(Model.Prefix).Title" data-path-slug-target="@(Model.Prefix).Slug">Générer</button></label><input name="@(Model.Prefix).Slug" value="@Model.Input.Slug" /></div><div class="learning-path-field-wide" data-editor-wrapper><label for="@(Model.Prefix)_Summary">@(Model.Language=="Français"?"Résumé":"Summary")</label><textarea id="@(Model.Prefix)_Summary" name="@(Model.Prefix).Summary" rows="7" data-path-summary-editor data-content-language="@(Model.Prefix=="French"?"fr":"en")" aria-label="@(Model.Language=="Français"?"Résumé en français":"Summary in English")">@Model.Input.Summary</textarea><p class="field-error" data-editor-error hidden>L’éditeur enrichi n’a pas pu être chargé. Vous pouvez continuer avec ce champ texte.</p></div><div class="learning-path-field-wide"><h3>SEO</h3></div><div><label>Titre SEO</label><input name="@(Model.Prefix).MetaTitle" value="@Model.Input.MetaTitle" maxlength="60" /></div><div><label>Description SEO</label><textarea name="@(Model.Prefix).MetaDescription" rows="3" maxlength="160">@Model.Input.MetaDescription</textarea></div><div class="learning-path-field-wide"><label>Statut</label><select name="@(Model.Prefix).PublicationStatus">@foreach(var status in Enum.GetValues<StudyStatus>()){<option value="@status" selected="@(status==Model.Input.PublicationStatus?"selected":null)">@status</option>}</select><small>Brouillon : non visible publiquement. Publié : visible dans cette langue.</small></div></div>
