@model string
@{
    var key = Model?.ToLowerInvariant() ?? "activity";
}
<svg class="admin-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (key)
    {
        case "eye": <g>
<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
<circle cx="12" cy="12" r="3" />
</g>; break;
        case "eye-off": <g>
<path d="m3 3 18 18M10.6 5.1A12 12 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3 3.8M6.2 6.2A19 19 0 0 0 2 12s3.5 7 10 7a12 12 0 0 0 5.8-1.8M9.9 9.9a3 3 0 0 0 4.2 4.2" />
</g>; break;
        case "dashboard": <g>
<rect x="3" y="3" width="7" height="7" rx="1.5" />
<rect x="14" y="3" width="7" height="7" rx="1.5" />
<rect x="3" y="14" width="7" height="7" rx="1.5" />
<rect x="14" y="14" width="7" height="7" rx="1.5" />
</g>; break;
        case "chevron-right": <g>
<path d="m9 5 7 7-7 7" />
</g>; break;
        case "globe-check": <g>
<path d="M12 21a9 9 0 1 1 9-9M3 12h18M12 3a18 18 0 0 1 2 10M12 3a18 18 0 0 0 0 18m3-3 2 2 4-4" />
</g>; break;
        case "add": <g>
<path d="M12 5v14M5 12h14" />
</g>; break;
        case "arrow-left": <g>
<path d="m15 18-6-6 6-6" />
<path d="M9 12h11" />
</g>; break;
        case "close": <g>
<path d="m6 6 12 12M18 6 6 18" />
</g>; break;
        case "search": <g>
<circle cx="10.8" cy="10.8" r="6.5" />
<path d="m16 16 4.5 4.5" />
</g>; break;
        case "filter": <g>
<path d="M4 5h16l-6 7v5l-4 2v-7z" />
</g>; break;
        case "reset": <g>
<path d="M4 12a8 8 0 1 0 2.3-5.7L4 8.5" />
<path d="M4 4v4.5h4.5" />
</g>; break;
        case "video": <g>
<rect x="3" y="5" width="13" height="14" rx="2" />
<path d="m16 10 5-3v10l-5-3z" />
<path d="m8 9 4 3-4 3z" />
</g>; break;
        case "document":
        case "text":
        case "seo": <g>
<path d="M5 3h10l4 4v14H5z" />
<path d="M15 3v5h4M8 12h8M8 16h6" />
</g>; break;
        case "clock": <g>
<circle cx="12" cy="12" r="9" />
<path d="M12 7v5l3 2" />
</g>; break;
        case "save": <g>
<path d="M5 3h12l2 2v16H5z" />
<path d="M8 3v6h8V3M8 21v-7h8v7" />
</g>; break;
        case "book":
        case "course":
        case "chapter": <g>
<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5z" />
<path d="M4 5.5v16M8 7h8M8 11h8" />
</g>; break;
        case "category":
        case "folder2":
        case "folder": <g>
<path d="M3 6.5A1.5 1.5 0 0 1 4.5 5H10l2 2h7.5A1.5 1.5 0 0 1 21 8.5v9A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5z" />
</g>; break;
        case "published": <g>
<path d="M5 3h10l4 4v14H5z" />
<path d="M15 3v5h4M8 14l2 2 5-5" />
</g>; break;
        case "language": <g>
<circle cx="12" cy="12" r="9" />
<path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
</g>; break;
        case "draft":
        case "edit": <g>
<path d="m4 16-.8 4.8L8 20l10.8-10.8a2.4 2.4 0 0 0-3.4-3.4z" />
<path d="m13.8 7.2 3 3" />
</g>; break;
        case "warning": <g>
<path d="m12 3 10 18H2z" />
<path d="M12 9v4M12 17h.01" />
</g>; break;
        case "mortarboard":
        case "lesson": <g>
<path d="M5 3h10l4 4v14H5z" />
<path d="M15 3v5h4M8 12h8M8 16h6" />
</g>; break;
        case "quiz": <g>
<rect x="5" y="4" width="14" height="17" rx="2" />
<rect x="9" y="2" width="6" height="4" rx="1" />
<path d="M10 11a2 2 0 1 1 3.5 1.3c-.8.8-1.5 1-1.5 2M12 18h.01" />
</g>; break;
        case "question":
        case "answer": <g>
<path d="M5 3h10l4 4v14H5z" />
<path d="M15 3v5h4M9 12a2 2 0 1 1 3.5 1.3c-.8.8-1.5 1-1.5 2M11 18h.01" />
</g>; break;
        case "path":
        case "learning-path": <g>
<circle cx="6" cy="6" r="2" />
<circle cx="18" cy="18" r="2" />
<path d="M8 6h5a5 5 0 0 1 5 5v5M6 8v8" />
</g>; break;
        case "settings": <g>
<circle cx="12" cy="12" r="3" />
<path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.4 1.4-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-2v-.2a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L9 17l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H7v-2h.8a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L9 9l1.4-1.4.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6V6h2v.4a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L20 9l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v2h-.4a1.7 1.7 0 0 0-1.6 1z" />
</g>; break;
        case "activity": <g>
<circle cx="12" cy="12" r="9" />
<path d="M12 7v5l3 2" />
</g>; break;
        case "preview":
        case "info": <g>
<circle cx="12" cy="12" r="9" />
<path d="M12 10v6M12 7h.01" />
</g>; break;
        case "image": <g>
<rect x="3" y="4" width="18" height="16" rx="2" />
<circle cx="8" cy="9" r="1" />
<path d="m4 17 5-5 3 3 2-2 6 5" />
</g>; break;
        case "external-link": <g>
<path d="M14 5h5v5M19 5l-8 8" />
<path d="M19 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" />
</g>; break;
        default: <g>
<circle cx="12" cy="12" r="9" />
<path d="M12 8v4l2 2" />
</g>; break;
    }
</svg>
