@model AdminQuestionFormViewModel
@{ var isEdit = Model.Id != Guid.Empty; ViewData["Title"] = isEdit ? "Modifier la question" : "Créer une question"; var action = isEdit ? "Edit" : "Create"; }
<div class="admin-page content-admin-page"><nav class="admin-breadcrumb" aria-label="Fil d’Ariane"><a asp-controller="Quizzes" asp-action="Index" asp-route-courseId="@Model.CourseId" asp-route-chapterId="@Model.ChapterId">Quiz</a><span>›</span><a asp-controller="Questions" asp-action="Index" asp-route-courseId="@Model.CourseId" asp-route-chapterId="@Model.ChapterId" asp-route-quizId="@Model.QuizId">@Model.QuizTitle</a><span>›</span><strong>@ViewData["Title"]</strong></nav><div class="admin-heading content-heading"><div><p class="eyebrow">QUESTION DU QUIZ</p><h1>@ViewData["Title"]</h1><p>Ajoutez une question et ses réponses.</p></div><a class="btn-ghost" asp-action="Index" asp-route-courseId="@Model.CourseId" asp-route-chapterId="@Model.ChapterId" asp-route-quizId="@Model.QuizId">Retour aux questions</a></div><form class="admin-form course-form" asp-action="@action" asp-route-courseId="@Model.CourseId" asp-route-chapterId="@Model.ChapterId" asp-route-quizId="@Model.QuizId" asp-route-id="@Model.Id" method="post">@await Html.PartialAsync("_AdminValidationSummary")<div class="quiz-question-grid"><section class="course-form-card"><div class="course-section-title"><span class="section-icon">@await Html.PartialAsync("_AdminIcon", "question")</span><div><h2>Informations générales</h2><p>Rédigez la question dans chaque langue.</p></div></div><label asp-for="Order">Ordre</label><input asp-for="Order" type="number" min="1" /><div class="course-tabs" role="tablist" aria-label="Traductions de la question"><button type="button" class="course-tab is-active" role="tab" aria-selected="true" data-question-tab="question-fr">Français</button><button type="button" class="course-tab" role="tab" aria-selected="false" data-question-tab="question-en">English</button></div><div id="question-fr" class="course-tab-panel" role="tabpanel"><label for="French-Text">Texte de la question</label><textarea id="French-Text" name="French.Text" rows="5">@Model.French.Text</textarea><label for="French-Status">Statut de publication</label><select id="French-Status" name="French.PublicationStatus">@foreach (var status in Enum.GetValues<StudyStatus>()) { <option value="@status" selected="@(status == Model.French.PublicationStatus ? "selected" : null)">@status</option> }</select></div><div id="question-en" class="course-tab-panel" role="tabpanel" hidden><label for="English-Text">Question text</label><textarea id="English-Text" name="English.Text" rows="5">@Model.English.Text</textarea><label for="English-Status">Publication status</label><select id="English-Status" name="English.PublicationStatus">@foreach (var status in Enum.GetValues<StudyStatus>()) { <option value="@status" selected="@(status == Model.English.PublicationStatus ? "selected" : null)">@status</option> }</select></div></section><section class="course-form-card"><div class="course-section-title"><span class="section-icon">@await Html.PartialAsync("_AdminIcon", "answer")</span><div><h2>Réponses</h2><p>Une seule bonne réponse est attendue.</p></div></div><div id="answers-list">@for (var i = 0; i < Model.Answers.Count; i++) { <partial name="_AnswerFields" model="(Model.Answers[i], i)" /> }</div><button class="btn-ghost" type="button" data-add-answer>+ Ajouter une réponse</button></section></div><div class="course-action-bar"><a class="btn-ghost" asp-action="Index" asp-route-courseId="@Model.CourseId" asp-route-chapterId="@Model.ChapterId" asp-route-quizId="@Model.QuizId">Annuler</a><button class="btn-main" type="submit">+ @(isEdit ? "Enregistrer les modifications" : "Enregistrer la question")</button></div></form></div>
@section Scripts { <script src="~/js/admin-question-form.js" asp-append-version="true"></script> }
