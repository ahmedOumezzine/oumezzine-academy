@model (AdminAnswerInput Input, int Index)
<div class="admin-answer-row" data-answer-row><input type="hidden" name="Answers[@Model.Index].Id" value="@Model.Input.Id" /><div><label for="answer-fr-@Model.Index">Français</label><input id="answer-fr-@Model.Index" name="Answers[@Model.Index].FrenchText" value="@Model.Input.FrenchText" placeholder="Texte de la réponse" /></div><div><label for="answer-en-@Model.Index">English</label><input id="answer-en-@Model.Index" name="Answers[@Model.Index].EnglishText" value="@Model.Input.EnglishText" placeholder="Answer text" /></div><label class="answer-correct"><input type="radio" name="CorrectAnswerIndex" value="@Model.Index" @(Model.Input.IsCorrect ? "checked" : null) data-correct-answer /> Bonne réponse</label><button type="button" class="icon-action danger" data-remove-answer data-confirm-delete-action data-confirm-message="retirer cette réponse du formulaire" aria-label="Retirer cette réponse du formulaire">×</button></div>
