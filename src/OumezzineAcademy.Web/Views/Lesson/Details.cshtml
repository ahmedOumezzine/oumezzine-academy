@model OumezzineAcademy.Models.Catalog.LessonDetailViewModel
@using OumezzineAcademy.Models.Catalog
@{
    ViewData["Seo"] = new SeoViewModel(string.IsNullOrWhiteSpace(Model.MetaTitle) ? $"{Model.Title} | Oumezzine Academy" : Model.MetaTitle!, Model.MetaDescription ?? Model.Summary ?? Model.Title);
    var currentIndex = Model.ChapterLessons.ToList().FindIndex(lesson => lesson.Slug == Model.Slug);
    var previousLesson = currentIndex > 0 ? Model.ChapterLessons[currentIndex - 1] : null;
    var nextLesson = currentIndex >= 0 && currentIndex < Model.ChapterLessons.Count - 1 ? Model.ChapterLessons[currentIndex + 1] : null;
    var videoCount = Model.ChapterLessons.Count(lesson => !string.IsNullOrWhiteSpace(lesson.VideoUrl));
    var chapterDuration = Model.ChapterLessons.Sum(lesson => lesson.DurationMinutes);
    var visualKey = $"{Model.CourseTitle} {Model.CourseSlug} {Model.ChapterTitle} {Model.Title} {Model.CategoryTitle}".ToLowerInvariant();
    var visualMark = visualKey.Contains("angular") ? "Angular" : visualKey.Contains("react") ? "React" : visualKey.Contains("docker") ? "Docker" : visualKey.Contains("sql") ? "SQL" : visualKey.Contains("asp.net") || visualKey.Contains("aspnet") ? ".NET" : visualKey.Contains("javascript") ? "JS" : visualKey.Contains("html") ? "HTML / CSS" : visualKey.Contains("git") ? "Git" : "Learn";
    var visualTag = visualKey.Contains("angular") ? "components · routing" : visualKey.Contains("react") ? "props · JSX" : visualKey.Contains("docker") ? "containers · compose" : visualKey.Contains("sql") ? "tables · queries" : "practical skills";
}

<section class="lesson-hero">
    <div class="lesson-hero-copy">
        <div class="badge-row"><a class="badge-soft" asp-area="" asp-controller="Course" asp-action="Details" asp-route-culture="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" asp-route-slug="@Model.CourseSlug"><i class="bi bi-journal-text" aria-hidden="true"></i> @Model.CourseTitle</a><a class="badge-soft" asp-area="" asp-controller="Category" asp-action="Details" asp-route-culture="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" asp-route-slug="@Model.CategorySlug">@Model.CategoryTitle</a>@if (Model.DurationMinutes > 0) { <span class="badge-soft"><i class="bi bi-clock" aria-hidden="true"></i> @Model.DurationMinutes min</span> }</div>
        <h1>@Model.Title</h1>
        <p>@Model.Summary</p>
        <div class="actions"><a class="btn-main" asp-area="" asp-controller="Course" asp-action="Details" asp-route-culture="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" asp-route-slug="@Model.CourseSlug"><i class="bi bi-arrow-left-circle" aria-hidden="true"></i> @L["Lesson_BackToCourse"]</a></div>
        @{ ViewData["ShareLabel"] = L["Lesson_Share"].Value; }<partial name="_ShareActions" />
    </div>
    <div class="lesson-hero-art" aria-label="Aperçu visuel de la leçon @Model.Title">@if (!string.IsNullOrWhiteSpace(Model.CourseThumbnail)) { <img class="lesson-cover-image" src="@Model.CourseThumbnail" alt="@Model.Title" /> } else { <div class="lesson-visual-mark">@visualMark</div><div class="code-window"><span></span><span></span><span></span><b>&lt;/&gt;</b></div><div class="load-chip">@visualTag</div><i class="bi bi-arrow-down-left art-arrow" aria-hidden="true"></i> }</div>
    <aside class="chapter-nav-card"><h2><i class="bi bi-list-check" aria-hidden="true"></i> Dans ce chapitre</h2><strong>@Model.ChapterTitle</strong><div class="chapter-nav-list">@foreach (var lesson in Model.ChapterLessons) { <a class="@(lesson.Slug == Model.Slug ? "active" : "")" asp-area="" asp-controller="Lesson" asp-action="Details" asp-route-culture="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" asp-route-slug="@lesson.Slug"><i class="bi bi-play-btn" aria-hidden="true"></i><span>@lesson.Title</span></a> } @foreach (var quiz in Model.ChapterQuizzes) { <a class="quiz-nav" asp-area="" asp-controller="Quiz" asp-action="Attempt" asp-route-culture="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" asp-route-slug="@quiz.Slug"><i class="bi bi-patch-question" aria-hidden="true"></i><span>@quiz.Title</span></a> }</div></aside>
</section>

<div class="lesson-page page">
    <div class="lesson-layout">
        <article class="lesson-main">
            @if (!string.IsNullOrWhiteSpace(Model.VideoUrl)) { <section class="lesson-video-card content-panel"><div class="video-copy"><h2><i class="bi bi-camera-video" aria-hidden="true"></i> Vidéo</h2><p>Cette leçon référence une vidéo externe. Ouvrez-la dans un nouvel onglet pour suivre la démonstration, puis revenez ici pour continuer le chapitre.</p><a class="btn-main" href="@Model.VideoUrl" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Ouvrir la vidéo</a></div><div class="video-preview" aria-label="Aperçu visuel de la vidéo, ouverture dans un nouvel onglet"><div class="preview-angular">A</div><strong>@Model.Title<br /><small>@Model.CourseTitle</small></strong><span class="preview-play"><i class="bi bi-play-fill" aria-hidden="true"></i></span><div class="preview-controls"><i class="bi bi-play-fill" aria-hidden="true"></i><span></span><small>Vidéo externe</small></div></div></section> }
            <section class="lesson-content-card content-panel rich-content"><h2><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Contenu de la leçon</h2><p class="lesson-intro">Cette leçon est encore concise. Utilisez le résumé, la vidéo éventuelle et le plan du chapitre pour avancer, puis validez vos acquis avec le quiz disponible.</p>@if (!string.IsNullOrWhiteSpace(Model.Description)) { @Html.Raw(Model.Description) } else { <p>Le contenu détaillé de cette leçon sera enrichi prochainement. Revenez au programme pour poursuivre votre apprentissage.</p> }@if (!string.IsNullOrWhiteSpace(Model.DocumentUrl)) { <p class="lesson-document"><a class="btn-ghost" href="@Model.DocumentUrl" target="_blank" rel="noopener"><i class="bi bi-file-earmark-arrow-down" aria-hidden="true"></i> Télécharger le document</a></p> }</section>
            <nav class="lesson-pager" aria-label="Navigation entre les leçons"><div>@if (previousLesson != null) { <a asp-area="" asp-controller="Lesson" asp-action="Details" asp-route-culture="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" asp-route-slug="@previousLesson.Slug"><span><i class="bi bi-chevron-left" aria-hidden="true"></i> Leçon précédente</span><strong>@previousLesson.Title</strong></a> } else { <span class="disabled"><span><i class="bi bi-chevron-left" aria-hidden="true"></i> Leçon précédente</span><strong>Aucune leçon précédente</strong></span> }</div><div>@if (nextLesson != null) { <a asp-area="" asp-controller="Lesson" asp-action="Details" asp-route-culture="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" asp-route-slug="@nextLesson.Slug"><span>Leçon suivante <i class="bi bi-chevron-right" aria-hidden="true"></i></span><strong>@nextLesson.Title</strong></a> } else { <span class="disabled"><span>Leçon suivante <i class="bi bi-chevron-right" aria-hidden="true"></i></span><strong>Aucune leçon suivante</strong></span> }</div></nav>
        </article>
        <aside class="lesson-sidebar">
            <section class="lesson-sidebar-card"><h2><i class="bi bi-bar-chart-line" aria-hidden="true"></i> Progression du chapitre</h2><div class="structural-stat"><i class="bi bi-book" aria-hidden="true"></i><strong>@Model.ChapterLessons.Count</strong><span>leçons dans ce chapitre</span></div><div class="structural-stat"><i class="bi bi-play-btn" aria-hidden="true"></i><strong>@videoCount</strong><span>vidéo@(videoCount > 1 ? "s" : "")</span></div><div class="structural-stat"><i class="bi bi-clock" aria-hidden="true"></i><strong>@chapterDuration</strong><span>min de contenu</span></div><a class="btn-ghost sidebar-back" asp-area="" asp-controller="Course" asp-action="Details" asp-route-culture="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" asp-route-slug="@Model.CourseSlug"><i class="bi bi-chevron-left" aria-hidden="true"></i> Retour au cours</a></section>
            <section class="lesson-motivation"><div class="motivation-art"><i class="bi bi-code-slash" aria-hidden="true"></i></div><h2>Apprenez à votre rythme</h2><p>Progressez étape par étape et développez vos compétences avec Oumezzine Academy.</p><div class="motivation-leaves"><i class="bi bi-bar-chart-fill" aria-hidden="true"></i></div></section>
        </aside>
    </div>
</div>
