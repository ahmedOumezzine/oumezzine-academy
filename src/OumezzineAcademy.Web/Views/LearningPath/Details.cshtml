@model OumezzineAcademy.Models.Catalog.LearningPathDetailViewModel
@using OumezzineAcademy.Models.Catalog
@{
    ViewData["Title"] = Model.Title;
    ViewData["Seo"] = new SeoViewModel(string.IsNullOrWhiteSpace(Model.MetaTitle) ? $"{Model.Title} | Oumezzine Academy" : Model.MetaTitle!, Model.MetaDescription ?? Model.Summary ?? Model.Title, Image: Model.Thumbnail);
    var pathKey = $"{Model.Title} {Model.Slug} {Model.CategoryTitle}".ToLowerInvariant();
    var pathMark = pathKey.Contains("frontend") ? "UI" : pathKey.Contains("backend") ? "API" : pathKey.Contains("full-stack") ? "FULL" : pathKey.Contains("debutant") || pathKey.Contains("getting-started") ? "WEB" : "PATH";
}

<div class="path-detail-hero">
    <div class="path-detail-breadcrumb page"><a asp-area="" asp-controller="Home" asp-action="Index" asp-route-culture="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">@L["Home"]</a><span>›</span><a asp-area="" asp-controller="LearningPath" asp-action="Index" asp-route-culture="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">@L["LearningPaths"]</a>@if (!string.IsNullOrWhiteSpace(Model.CategoryTitle)) { <span>›</span><span>@Model.CategoryTitle</span> }<span>›</span><span aria-current="page">@Model.Title</span></div>
    <div class="path-detail-hero-grid page">
        <div class="path-detail-copy"><div class="badge-row"><span class="badge-soft">@Model.Level</span><span class="badge-soft">@Model.CourseCount @L["Paths_Courses"]</span>@if (!string.IsNullOrWhiteSpace(Model.CategoryTitle)) { <span class="badge-soft">@Model.CategoryTitle</span> }</div><h1>@Model.Title</h1>@if (!string.IsNullOrWhiteSpace(Model.Summary)) { <div class="learning-path-rich-summary">@Html.Raw(Model.Summary)</div> }<p class="path-detail-lead">@L["Paths_DetailText"]</p><div class="actions"><a class="btn-main" href="#path-courses"><i class="bi bi-play-circle" aria-hidden="true"></i> @L["Paths_Start"]</a><a class="btn-ghost" asp-area="" asp-controller="LearningPath" asp-action="Index" asp-route-culture="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">@L["Paths_Back"]</a></div>@{ ViewData["ShareLabel"] = L["Paths_ShareDetail"].Value; }<partial name="_ShareActions" /></div>
        <div class="path-detail-cover" role="img" aria-label="@Model.Title">@if (!string.IsNullOrWhiteSpace(Model.Thumbnail)) { <img src="@Model.Thumbnail" alt="@Model.Title" /> } else { <div class="path-cover-surface"><span class="path-cover-label"><i class="bi bi-signpost-split" aria-hidden="true"></i> @Model.CategoryTitle</span><h2>@pathMark</h2><p>@Model.Title</p><i class="bi bi-layers path-cover-icon" aria-hidden="true"></i></div> }</div>
    </div>
</div>

<div class="page path-detail-page"><section class="path-detail-stats"><div><i class="bi bi-grid" aria-hidden="true"></i><strong>@Model.CourseCount</strong><small>@L["Paths_Courses"]</small></div><div><i class="bi bi-play-btn" aria-hidden="true"></i><strong>@Model.Courses.Sum(c => c.LessonCount)</strong><small>@L["Paths_Lessons"]</small></div><div><i class="bi bi-patch-question" aria-hidden="true"></i><strong>@Model.Courses.Sum(c => c.QuizCount)</strong><small>@L["Paths_Quizzes"]</small></div><div><i class="bi bi-bar-chart" aria-hidden="true"></i><strong>@Model.Level</strong><small>@L["Paths_Level"]</small></div></section>
    <div class="path-detail-layout"><main><section class="content-panel path-about-card"><h2><i class="bi bi-info-circle" aria-hidden="true"></i> @L["Paths_About"]</h2>@if (!string.IsNullOrWhiteSpace(Model.Summary)) { <div class="learning-path-rich-summary">@Html.Raw(Model.Summary)</div> } else { <p>@Model.CategorySummary</p> }<div class="path-chip-row">@if (!string.IsNullOrWhiteSpace(Model.CategoryTitle)) { <span><i class="bi bi-folder" aria-hidden="true"></i> @Model.CategoryTitle</span> }<span><i class="bi bi-bar-chart" aria-hidden="true"></i> @Model.Level</span><span><i class="bi bi-grid" aria-hidden="true"></i> @Model.CourseCount @L["Paths_Courses"]</span></div></section>
        <section id="path-courses" class="path-steps-section"><div class="section-head"><div><h2><i class="bi bi-diagram-3" aria-hidden="true"></i> @L["Paths_Steps"]</h2><p>@L["Paths_DetailText"]</p></div></div>@if (Model.Courses.Count == 0) { <div class="empty path-empty">@L["Paths_NoCourses"]</div> } else { <div class="path-timeline">@foreach (var course in Model.Courses) { <div class="path-step"><span class="path-step-number">@course.Order.ToString("00")</span><article class="path-step-card"><div class="path-step-visual @(string.IsNullOrWhiteSpace(course.ThumbnailUrl) ? "" : "has-image")">@if (!string.IsNullOrWhiteSpace(course.ThumbnailUrl)) { <img src="@course.ThumbnailUrl" alt="@course.CourseTitle" loading="lazy" /> }<div class="path-step-fallback" aria-hidden="true"><i class="bi bi-code-slash"></i></div></div><div class="path-step-copy"><h3>@course.CourseTitle</h3>@if (!string.IsNullOrWhiteSpace(course.Summary)) { <p>@course.Summary</p> }<div class="path-step-meta"><span>@course.LessonCount @L["Paths_Lessons"]</span><span>@course.QuizCount @L["Paths_Quizzes"]</span><span>@course.DurationMinutes @L["CourseDetail_Minutes"]</span></div></div><a class="text-link" asp-area="" asp-controller="Course" asp-action="Details" asp-route-culture="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" asp-route-slug="@course.CourseSlug">@L["Paths_ViewCourse"] <i class="bi bi-arrow-right" aria-hidden="true"></i></a></article></div> }</div> }</section></main>
        <aside class="path-detail-sidebar"><section class="sidebar-card"><h2><i class="bi bi-signpost-split" aria-hidden="true"></i> @L["Paths_About"]</h2><p>@L["Paths_DetailText"]</p><div class="path-side-list"><span><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @L["Paths_Steps"]</span><span><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @L["Paths_Courses"]</span><span><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @L["Paths_Lessons"]</span></div></section><section class="sidebar-card path-launch-card"><div class="launch-art"><i class="bi bi-rocket-takeoff" aria-hidden="true"></i></div><h2>@L["Paths_Start"]</h2><p>@L["Paths_DetailText"]</p><a class="btn-main" href="#path-courses">@L["Paths_Start"] <i class="bi bi-arrow-right" aria-hidden="true"></i></a><div class="launch-points"><span><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @L["CourseDetail_Free"]</span><span><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @L["CourseDetail_Accessible"]</span></div></section></aside>
    </div>
</div>
