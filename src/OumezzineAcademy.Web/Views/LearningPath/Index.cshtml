@model OumezzineAcademy.Models.Catalog.LearningPathListViewModel
@using OumezzineAcademy.Models.Catalog
@{
    ViewData["Seo"] = new SeoViewModel(L["Paths_SeoTitle"].Value, L["Paths_SeoDescription"].Value);
}

<section class="path-hero">
    <div class="path-hero-copy"><p class="eyebrow">@L["Paths_Eyebrow"]</p><h1>@L["Paths_Title"]</h1><p>@L["Paths_Description"]</p>@{ ViewData["ShareLabel"] = L["Paths_Share"].Value; }<partial name="_ShareActions" /></div>
    <div class="roadmap-art" aria-hidden="true"><div class="roadmap-cloud"></div><div class="roadmap-route"></div><i class="bi bi-code-slash roadmap-node node-code"></i><i class="bi bi-database roadmap-node node-db"></i><i class="bi bi-mortarboard-fill roadmap-node node-cap"></i><i class="bi bi-flag-fill roadmap-flag"></i><div class="roadmap-label label-learn">@L["Paths_Learn"]</div><div class="roadmap-label label-progress">@L["Paths_Progress"]</div><div class="roadmap-label label-goal">@L["Paths_Goals"]</div></div>
</section>

<div class="path-page page">
    <form class="path-filters" method="get"><div><i class="bi bi-grid-fill" aria-hidden="true"></i><label class="sr-only" for="path-category">@L["Paths_Category"]</label><select id="path-category" name="category"><option value="">@L["Paths_AllCategories"]</option>@foreach (var category in Model.Categories) { <option value="@category.Slug" selected="@(Model.Category == category.Slug)">@category.Title</option> }</select></div><div><i class="bi bi-bar-chart-fill" aria-hidden="true"></i><label class="sr-only" for="path-level">@L["Paths_AllLevels"]</label><select id="path-level" name="level"><option value="">@L["Paths_AllLevels"]</option>@foreach (var level in Enum.GetValues<StudyLevel>()) { <option value="@level" selected="@(Model.Level == level)">@level</option> }</select></div><button class="btn-main" type="submit">@L["Paths_Filter"]</button></form>
    @if (!Model.Paths.Any()) { <div class="empty">@L["Paths_NoResults"]</div> } else { <section class="roadmap-grid" aria-label="@L["Paths_ListLabel"]">@foreach (var path in Model.Paths) { var key = $"{path.Title} {path.Slug} {path.CategoryTitle}".ToLowerInvariant(); var mark = key.Contains("frontend") ? "UI" : key.Contains("backend") ? "API" : key.Contains("full-stack") ? "FULL" : key.Contains("debutant") || key.Contains("getting-started") ? "WEB" : "PATH"; <a class="roadmap-card" asp-area="" asp-controller="LearningPath" asp-action="Details" asp-route-culture="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" asp-route-slug="@path.Slug"><div class="roadmap-card-visual">@if (!string.IsNullOrWhiteSpace(path.Thumbnail)) { <img src="@path.Thumbnail" alt="@path.Title" loading="lazy" /> } else { <div class="path-dynamic-mark">@mark</div><div class="path-mini-window"><span></span><span></span><span></span></div> }</div><div class="roadmap-card-body"><div class="badge-row"><span class="badge-soft">@path.Level</span><span class="badge-soft">@path.CourseCount @L["Paths_Courses"]</span></div><h2>@path.Title</h2><p>@path.Summary</p><div class="roadmap-card-bottom"><span><i class="bi bi-book" aria-hidden="true"></i> @path.CourseCount @L["Paths_Courses"]</span><span class="roadmap-arrow" aria-hidden="true"><i class="bi bi-arrow-right"></i></span></div></div></a> }</section> }
    <section class="path-benefits"><div class="path-benefits-copy"><p class="eyebrow">@L["Paths_BenefitsEyebrow"]</p><h2>@L["Paths_BenefitsTitle"]</h2><p>@L["Paths_BenefitsText"]</p></div><div class="path-benefits-grid"><div><i class="bi bi-bullseye" aria-hidden="true"></i><strong>@L["Paths_ClearDirection"]</strong><span>@L["Paths_ClearDirectionText"]</span></div><div><i class="bi bi-bar-chart-line" aria-hidden="true"></i><strong>@L["Paths_EffectiveProgress"]</strong><span>@L["Paths_EffectiveProgressText"]</span></div><div><i class="bi bi-star" aria-hidden="true"></i><strong>@L["Paths_ConcreteSkills"]</strong><span>@L["Paths_ConcreteSkillsText"]</span></div></div></section>
</div>
