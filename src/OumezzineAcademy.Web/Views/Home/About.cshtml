@using OumezzineAcademy.Models.Catalog
@inject OumezzineAcademy.Web.Services.ILocalizedUrlService LocalizedUrls
@{
    ViewData["Title"] = L["About_SeoTitle"].Value;
    ViewData["Seo"] = new SeoViewModel(L["About_SeoTitle"].Value, L["About_SeoDescription"].Value);
    var publicNavigation = LocalizedUrls.GetPublicNavigation();
}

<section class="about-page-hero">
<div class="about-page-hero-copy"><p class="eyebrow">@L["About_Hero_Eyebrow"]</p><h1><span>@L["About_TitleLead"]</span> <em>@L["About_TitleAccent"]</em></h1><p>@L["About_Intro"]</p><div class="about-benefits"><span><i class="bi bi-journal-check" aria-hidden="true"></i>@L["About_BenefitCourses"]</span><span><i class="bi bi-signpost-split" aria-hidden="true"></i>@L["About_BenefitPaths"]</span><span><i class="bi bi-graph-up-arrow" aria-hidden="true"></i>@L["About_BenefitProgress"]</span></div>@{ ViewData["ShareLabel"] = L["Share"].Value; }<partial name="_ShareActions" /></div>
    <div class="about-learning-art"><img class="about-hero-image" src="~/images/about/about-hero-laptop.svg" alt="@L["About_HeroImageAlt"]" /><div class="about-orbit-card about-courses"><i class="bi bi-book" aria-hidden="true"></i><strong>@L["About_Courses"]</strong><small>@L["About_CourseContent"]</small></div><div class="about-orbit-card about-lessons"><i class="bi bi-play-btn" aria-hidden="true"></i><strong>@L["About_Lessons"]</strong><small>@L["About_ShortClear"]</small></div><div class="about-orbit-card about-quizzes"><i class="bi bi-patch-question" aria-hidden="true"></i><strong>@L["About_Quizzes"]</strong><small>@L["About_CheckKnowledge"]</small></div><div class="about-orbit-card about-paths"><i class="bi bi-signpost-split" aria-hidden="true"></i><strong>@L["LearningPaths"]</strong><small>@L["About_GuidedPaths"]</small></div><span class="about-note note-two">@L["About_SmallSteps"]</span></div>
</section>

<div class="about-page page">
    <section class="about-section"><div class="about-section-heading"><p class="eyebrow">@L["About_Method"]</p><h2>@L["About_MethodTitle"]</h2><p>@L["About_MethodDescription"]</p></div><div class="method-grid"><div class="method-card method-blue"><i class="bi bi-book" aria-hidden="true"></i><div><h3>@L["About_StructuredCourses"]</h3><p>@L["About_StructuredCoursesText"]</p></div></div><div class="method-card method-mint"><i class="bi bi-patch-question" aria-hidden="true"></i><div><h3>@L["About_UsefulQuizzes"]</h3><p>@L["About_UsefulQuizzesText"]</p></div></div><div class="method-card method-purple"><i class="bi bi-signpost-split" aria-hidden="true"></i><div><h3>@L["About_GuidedPaths"]</h3><p>@L["About_GuidedPathsText"]</p></div></div><div class="method-card method-orange"><i class="bi bi-phone" aria-hidden="true"></i><div><h3>@L["About_SimpleExperience"]</h3><p>@L["About_SimpleExperienceText"]</p></div></div></div></section>
    <section class="about-section about-steps-section"><div class="about-section-heading"><p class="eyebrow">@L["About_Steps"]</p><h2>@L["About_HowTitle"]</h2><p>@L["About_HowDescription"]</p></div><div class="about-steps"><div><span>1</span><i class="bi bi-search" aria-hidden="true"></i><h3>@L["About_Choose"]</h3><p>@L["About_ChooseText"]</p></div><div><span>2</span><i class="bi bi-book" aria-hidden="true"></i><h3>@L["About_Learn"]</h3><p>@L["About_LearnText"]</p></div><div><span>3</span><i class="bi bi-patch-question" aria-hidden="true"></i><h3>@L["About_Test"]</h3><p>@L["About_TestText"]</p></div><div><span>4</span><i class="bi bi-bar-chart-line" aria-hidden="true"></i><h3>@L["About_Continue"]</h3><p>@L["About_ContinueText"]</p></div></div></section>
    <section class="about-why"><div><p class="eyebrow">@L["About_Benefits"]</p><h2>@L["About_WhyTitle"]</h2></div><div class="about-why-grid"><div><i class="bi bi-lightbulb" aria-hidden="true"></i><strong>@L["About_Clarity"]</strong><p>@L["About_ClarityText"]</p></div><div><i class="bi bi-graph-up-arrow" aria-hidden="true"></i><strong>@L["About_Progress"]</strong><p>@L["About_ProgressText"]</p></div><div><i class="bi bi-heart" aria-hidden="true"></i><strong>@L["About_Simplicity"]</strong><p>@L["About_SimplicityText"]</p></div></div></section>
    <section class="about-final-cta"><div class="about-cta-icon"><i class="bi bi-mortarboard-fill" aria-hidden="true"></i></div><div><h2>@L["About_CtaTitle"]</h2><p>@L["About_CtaText"]</p></div><a class="btn-main" href="@publicNavigation.Courses">@L["About_ExploreCourses"] <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a><span class="about-cta-note">@L["About_Future"]</span></section>
</div>
