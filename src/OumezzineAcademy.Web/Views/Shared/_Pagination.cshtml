
<div class="catalog-pagination">
    <div class="catalog-pagination-summary">
        <p>
            @L["Showing"] @((Model.PageIndex - 1) * Model.PageSize + 1)
            @L["To"] @(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalItems))
            @L["Of"] @Model.TotalItems
        </p>
    </div>
    <div class="catalog-pagination-controls">
        <ul class="pagination-list">
            @if (Model.PageIndex > 1)
            {
                <li>
                    <a href="#" class="pagination-link" data-page="@(@Model.PageIndex - 1)">@L["Previous"]</a>
                </li>
            }
            else
            {
                <li class="is-disabled"><span>@L["Previous"]</span></li>
            }

            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                if (i == Model.PageIndex)
                {
                    <li class="is-active">
                        <span>@i</span>
                    </li>
                }
                else
                {
                    <li>
                        <a href="#" class="pagination-link" data-page="@i">@i</a>
                    </li>
                }
            }

            @if (Model.PageIndex < Model.TotalPages)
            {
                <li>
                    <a href="#" class="pagination-link" data-page="@(@Model.PageIndex + 1)">@L["Next"]</a>
                </li>
            }
            else
            {
                <li class="is-disabled"><span>@L["Next"]</span></li>
            }
        </ul>
    </div>
</div>
